# Copie para ".env" (na raiz do projeto, FORA de /public) e preencha.
# Nunca coloque este arquivo preenchido no Git nem em /public.

# Ambiente: dev mostra erros detalhados; producao esconde.
APP_ENV=dev

# Chave secreta do app (assina o token do link do WhatsApp). Gere com:
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Fuso horário da loja
APP_TIMEZONE=America/Sao_Paulo

# Banco: sqlite (MVP) ou pgsql (Neon, produção)
DB_DRIVER=sqlite
DB_SQLITE_PATH=data/restaurante.sqlite

# Só para DB_DRIVER=pgsql (Neon). Use sslmode=require.
DB_PG_DSN=
DB_PG_USER=
DB_PG_PASSWORD=

# WhatsApp Cloud API (Etapa 4). Deixe vazio até lá.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
