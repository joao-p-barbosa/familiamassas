# Copie para ".env" (na raiz do projeto, FORA de /public) e preencha.
# Nunca coloque este arquivo preenchido no Git nem em /public.

# Ambiente: dev mostra erros detalhados; producao esconde.
APP_ENV=dev

# Chave secreta do app (assina o token do link do WhatsApp). Gere com:
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Fuso horário da loja
APP_TIMEZONE=America/Sao_Paulo

# Banco: sqlite (desenvolvimento, arquivo data/restaurante.sqlite) ou pgsql (Neon, na hospedagem).
# Sem DB_DRIVER, a presença de DATABASE_URL liga o Postgres.
DB_DRIVER=sqlite
DB_SQLITE_PATH=data/restaurante.sqlite

# Postgres (Neon). Cole a "connection string" do Neon (Connect > Connection string):
#   postgresql://usuario:senha@host/banco?sslmode=require
# Na hospedagem isto é uma variável de ambiente (nunca vai para o Git). Alternativa: DB_PG_DSN + DB_PG_USER + DB_PG_PASSWORD.
DATABASE_URL=
DB_PG_DSN=
DB_PG_USER=
DB_PG_PASSWORD=

# Só para rodar os testes contra o Postgres de verdade (php -d extension=pdo_sqlite tests/regras.php pg): o teste cria um schema temporário
# e o apaga no fim, sem tocar nos seus dados. Pode ser a mesma connection string do Neon.
TEST_DATABASE_URL=

# Só na hospedagem: SENHA_ADMIN_INICIAL e SENHA_ATENDENTE_INICIAL (8+ caracteres) definem as senhas dos dois usuários
# quando o banco é criado, e TRUST_PROXY=1 faz o bloqueio de login usar o IP de X-Forwarded-For (veja docs/DEPLOY.md).

# WhatsApp Cloud API (Etapa 4). Sem TOKEN ou sem PHONE_NUMBER_ID o bot fica no MODO SIMULADO: nada sai para a Meta e
# a tela WhatsApp do painel tem um simulador da conversa. Passo a passo da Meta em docs/DEPLOY.md.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Opcionais: 1 força o modo simulado; versão da Graph API; nome do template "utility" dos avisos fora da janela de 24 h
# (parâmetros {{1}} número do pedido e {{2}} status; "nenhum" desliga esses avisos).
WHATSAPP_SIMULAR=
WHATSAPP_API_VERSAO=v23.0
WHATSAPP_MODELO_STATUS=atualizacao_pedido
# Endereço público do site, usado nos links que o bot manda (sem ele, vale o endereço da requisição).
APP_URL=
# Chave do endereço /cron/whatsapp?chave=... (opcional: para um serviço de cron externo processar a fila de avisos).
CRON_TOKEN=
