# Hospedagem compartilhada (Apache): aponte o domínio para esta pasta /public.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Arquivo real (CSS, JS, imagem)? Entrega direto.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  # Todo o resto vai para o index.php
  RewriteRule ^ index.php [L]
</IfModule>

# Cabeçalhos de segurança e cache. (A pasta /uploads tem o próprio .htaccess, que bloqueia scripts.)
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  <FilesMatch "\.(woff2|webp|avif|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
